# ===================================================================
# ContentSignal Environment Configuration Template
# ===================================================================

# Application Environment (development | production)
APP_ENV=development

# Database URL (Defaults to SQLite in project root if not specified)
# For Render persistent disk: sqlite:////var/data/content_intelligence.db
# For PostgreSQL / Supabase: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///content_intelligence.db

# JWT Secret for Session Tokens (Must be set to a secure random string in production)
JWT_SECRET=super-secret-key-change-in-production-flyrank-2026

# Development OTP Mode: Default false.
# When false: OTP is NEVER returned in API or shown in UI, and real email delivery is required.
DEV_OTP_MODE=false

# ===================================================================
# CORS & FRONTEND URL CONFIGURATION
# ===================================================================
# Set to your deployed Vercel frontend URL in production
# Supports comma-separated URLs for preview deployments
FRONTEND_URL=https://your-app.vercel.app

# ===================================================================
# EMAIL DELIVERY CONFIGURATION (Gmail SMTP / Brevo / Resend)
# ===================================================================
# Primary Email Provider: 'smtp' or 'resend' (Defaults to auto-detect)
EMAIL_PROVIDER=smtp

# --- Provider 1: Authenticated SMTP (Recommended for Render / Gmail / Brevo) ---
# To use Gmail SMTP:
# 1. Open Google Account Security: https://myaccount.google.com/security
# 2. Turn 2-Step Verification ON.
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Generate an App Password for "ContentSignal".
# 5. Enter your Gmail and 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com
EMAIL_FROM_NAME=ContentSignal

# --- Provider 2: Resend API (Optional) ---
# Note: Free Resend test domain (onboarding@resend.dev) can only send to your own Resend account email.
# For production signups with any user, verify a custom domain at https://resend.com/domains
RESEND_API_KEY=re_your_api_key_here

# ===================================================================
# SMS PROVIDER CONFIGURATION (Optional - Twilio / MSG91)
# ===================================================================
# Set provider to 'twilio' or 'msg91' if SMS OTP is enabled
SMS_PROVIDER=none

# Twilio Configuration:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (India DLT Compliant SMS):
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=

# ===================================================================
# AI ASSISTANT / LLM KEYS (Optional)
# ===================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
