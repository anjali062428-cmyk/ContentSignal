# ===================================================================
# ContentSignal Environment Configuration Template
# ===================================================================

# Application Environment (development | production)
APP_ENV=development

# Development OTP Mode: Default false.
# When false: OTP is NEVER returned in API or shown in UI, and real email delivery is required.
DEV_OTP_MODE=false

# Database URL (Defaults to SQLite in project root if not specified)
DATABASE_URL=sqlite:///content_intelligence.db

# JWT Secret for Session Tokens
JWT_SECRET=super-secret-key-change-in-production-flyrank-2026

# ===================================================================
# GMAIL SMTP EMAIL DELIVERY CONFIGURATION
# ===================================================================
# To receive real OTP verification emails in your Gmail inbox:
#
# 1. Open your Google Account Security: https://myaccount.google.com/security
# 2. Make sure "2-Step Verification" is ON.
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Generate an App Password (Name: "ContentSignal").
# 5. Copy the 16-character code (spaces will be automatically cleaned).
# 6. Fill in your Gmail address and 16-character App Password below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com
EMAIL_FROM_NAME=ContentSignal

# --- Alternative Email Provider: Resend API ---
# If using Resend instead of SMTP:
# RESEND_API_KEY=re_your_api_key_here

# ===================================================================
# AI ASSISTANT / LLM KEYS (Optional)
# ===================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
