# ===================================================================
# ContentSignal Environment Configuration Template
# ===================================================================

# Application Environment (development | production)
APP_ENV=development

# Database URL (Defaults to SQLite in project root if not specified)
# For Render persistent disk: sqlite:////var/data/content_intelligence.db
# For PostgreSQL / Supabase: postgresql://user:password@host:5432/dbname
DATABASE_URL=sqlite:///content_intelligence.db

# JWT Secret for Session Tokens (Must be set to a secure random string in production)
JWT_SECRET=super-secret-key-change-in-production-flyrank-2026

# Development OTP Mode: Default false.
# When false: OTP is NEVER returned in API or shown in UI, and real email delivery is required.
DEV_OTP_MODE=false

# ===================================================================
# CORS & FRONTEND URL CONFIGURATION
# ===================================================================
# Set to your deployed Vercel frontend URL in production
# Supports comma-separated URLs for preview deployments
FRONTEND_URL=https://your-app.vercel.app

# ===================================================================
# GMAIL SMTP EMAIL DELIVERY CONFIGURATION
# ===================================================================
# To receive real OTP verification emails in your Gmail inbox:
# 1. Open Google Account Security: https://myaccount.google.com/security
# 2. Make sure "2-Step Verification" is ON.
# 3. Visit https://myaccount.google.com/apppasswords
# 4. Generate an App Password (Name: "ContentSignal").
# 5. Copy the 16-character code into SMTP_PASS below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM=your_email@gmail.com
EMAIL_FROM_NAME=ContentSignal

# --- Alternative Email Provider: Resend API (Optional) ---
# If using Resend instead of SMTP:
RESEND_API_KEY=re_your_api_key_here

# ===================================================================
# AI ASSISTANT / LLM KEYS (Optional)
# ===================================================================
OPENAI_API_KEY=
GEMINI_API_KEY=
